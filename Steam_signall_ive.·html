<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Steam · Signal Panel</title>
<style>
:root{
  --bg:#0e1a30; --panel:#16233f; --panel2:#1b2b4a; --edge:#26374f;
  --ink:#eef0ea; --muted:#8fa1c2; --faint:#63769a;
  --gold:#e8b94a; --bull:#5ee08a; --bear:#f0655a; --slate:#56688c;
  --fastc:#6db6ff; --midc:#e8b94a; --slowc:#c98be0; --grid:#213150;
  --upbar:#3f8f5e; --dnbar:#a54b48;
  --mono:'Courier New',ui-monospace,monospace;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(1200px 700px at 70% -10%,#16294a66,transparent),var(--bg);
  font-family:var(--sans);color:var(--ink);-webkit-font-smoothing:antialiased;padding:26px 18px}
.wrap{max-width:940px;margin:0 auto}
.card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--edge);
  border-radius:14px;padding:20px 22px 16px;box-shadow:0 20px 60px -30px #000,inset 0 1px 0 #ffffff0a;
  animation:rise .5s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* search / load bar */
.loadbar{display:flex;gap:8px;margin-bottom:14px}
.loadbar input{flex:1;background:#0d1830;border:1px solid var(--edge);border-radius:9px;color:var(--ink);
  font-family:var(--mono);font-size:14px;letter-spacing:1px;padding:9px 13px;outline:none;text-transform:uppercase}
.loadbar input:focus{border-color:var(--gold)}
.loadbar button{background:var(--gold);color:#1a2340;border:none;border-radius:9px;font-family:var(--mono);
  font-weight:700;font-size:13px;letter-spacing:1px;padding:9px 18px;cursor:pointer}
.loadbar button:disabled{opacity:.5;cursor:wait}

/* status line */
.status{font-family:var(--mono);font-size:11px;color:var(--faint);margin:0 2px 12px;min-height:15px}
.status.err{color:var(--bear)}

/* header */
.hd{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.tick{font-family:var(--mono);font-size:30px;font-weight:700;letter-spacing:2px;line-height:1}
.tick b{color:var(--gold)}
.name{color:var(--muted);font-size:12.5px;margin-top:5px;letter-spacing:.3px}
.pxwrap{text-align:right}
.px{font-family:var(--mono);font-size:26px;font-weight:700}
.freshrow{display:flex;gap:6px;justify-content:flex-end;margin-top:6px;flex-wrap:wrap}
.chip{font-family:var(--mono);font-size:10px;letter-spacing:.4px;padding:2px 7px;border-radius:999px;
  border:1px solid var(--edge);color:var(--muted);background:#0d1830}
.chip.live{color:var(--bull);border-color:#2f6b47;background:#0f2419}
.chip.warn{color:var(--gold);border-color:#6b5a2f;background:#241f0f}
.rule{height:1px;background:linear-gradient(90deg,transparent,var(--edge) 12%,var(--edge) 88%,transparent);margin:16px 0}

/* funnel */
.eye{font-size:10px;letter-spacing:2.4px;color:var(--faint);text-transform:uppercase;margin-bottom:9px}
.funnel{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:0 10px;align-items:stretch}
.tier{background:#0e1b32;border:1px solid var(--edge);border-radius:11px;padding:12px 14px;position:relative;overflow:hidden}
.tier::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--c,var(--slate))}
.tier .lab{font-size:9.5px;letter-spacing:2px;color:var(--faint);text-transform:uppercase}
.tier .st{font-family:var(--mono);font-weight:700;font-size:17px;margin-top:6px;color:var(--c,var(--ink));letter-spacing:.5px;display:flex;align-items:center;gap:7px}
.tier .st .d{width:8px;height:8px;border-radius:50%;background:var(--c);box-shadow:0 0 10px var(--c);flex-shrink:0}
.tier .sub{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.35}
.arw{display:flex;align-items:center;color:var(--faint);font-size:18px}

/* verdict */
.verdict{display:flex;align-items:center;gap:16px;margin-top:14px;background:#0d1830;border:1px solid var(--edge);border-radius:10px;padding:11px 14px}
.vtext{flex:1}
.vtext .h{font-family:var(--mono);font-weight:700;font-size:14px;letter-spacing:.4px}
.vtext .s{font-size:11px;color:var(--muted);margin-top:3px}
.meter{width:210px;flex-shrink:0}
.meter .track{height:7px;border-radius:6px;background:linear-gradient(90deg,var(--bear),#c9a24a 46%,var(--bull));position:relative;opacity:.85}
.meter .pin{position:absolute;top:-4px;width:3px;height:15px;border-radius:2px;background:#fff;box-shadow:0 0 8px #fff9;transform:translateX(-50%);transition:left .6s ease}
.meter .scale{display:flex;justify-content:space-between;font-size:8.5px;color:var(--faint);letter-spacing:.6px;margin-top:5px;text-transform:uppercase}

/* chips */
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}
.mchip{font-family:var(--mono);font-size:11px;padding:4px 9px;border-radius:7px;background:#0d1830;border:1px solid var(--edge);color:var(--muted)}
.mchip b{color:var(--ink)}
.mchip .up{color:var(--bull)} .mchip .dn{color:var(--bear)} .mchip .gd{color:var(--gold)}

/* chart panels */
.panel{margin-top:16px;background:#0c1730;border:1px solid var(--edge);border-radius:11px;padding:12px 12px 6px}
.ptitle{font-size:10px;letter-spacing:2px;color:var(--faint);text-transform:uppercase;margin:0 2px 6px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px}
.legend{display:flex;gap:14px;font-family:var(--mono);font-size:10.5px;color:var(--muted);text-transform:none;letter-spacing:0}
.legend i{display:inline-block;width:14px;height:2.5px;border-radius:2px;vertical-align:middle;margin-right:5px}
svg{display:block;width:100%;height:auto}
.gl{stroke:var(--grid);stroke-width:1}
.ln{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
.draw{stroke-dasharray:6000;stroke-dashoffset:6000;animation:draw 1.4s .2s ease forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.xm{stroke:#ffffff55;stroke-width:1;stroke-dasharray:3 3}
.xmlab{font-family:var(--mono);font-size:9.5px;fill:var(--ink)}
.subnote{font-size:9.5px;color:var(--faint);font-family:var(--mono);margin:2px 2px 0}
.foot{font-size:10px;color:var(--faint);margin-top:12px;line-height:1.5}
.foot b{color:var(--muted)}
#content{display:none}
.skel{padding:40px 0;text-align:center;color:var(--faint);font-family:var(--mono);font-size:13px;letter-spacing:1px}
@media (max-width:680px){
  .funnel{grid-template-columns:1fr;gap:8px}.arw{transform:rotate(90deg);justify-content:center;height:14px}
  .verdict{flex-direction:column;align-items:stretch}.meter{width:100%}
}
@media (prefers-reduced-motion:reduce){.card,.draw{animation:none}.draw{stroke-dashoffset:0}.meter .pin{transition:none}}
</style>
</head>
<body>
<div class="wrap">
  <div class="loadbar">
    <input id="symIn" placeholder="SYMBOL — e.g. HAL, BEL, TCS" value="HAL" spellcheck="false">
    <button id="goBtn" onclick="load()">LOAD</button>
  </div>
  <div class="status" id="status"></div>

  <div class="card">
    <div class="skel" id="skel">enter a symbol and press LOAD</div>
    <div id="content">

      <div class="hd">
        <div>
          <div class="tick" id="hTick"><b>—</b></div>
          <div class="name" id="hName">&nbsp;</div>
        </div>
        <div class="pxwrap">
          <div class="px" id="hPx">—</div>
          <div class="freshrow" id="hChips"></div>
        </div>
      </div>

      <div class="rule"></div>

      <div class="eye">Decision funnel — market ▸ sector ▸ stock</div>
      <div class="funnel">
        <div class="tier" id="tMkt"><div class="lab">Market</div><div class="st"><span class="d"></span><span id="tMktSt">—</span></div><div class="sub" id="tMktSub">&nbsp;</div></div>
        <div class="arw">▸</div>
        <div class="tier" id="tSec"><div class="lab">Sector</div><div class="st"><span class="d"></span><span id="tSecSt">—</span></div><div class="sub" id="tSecSub">&nbsp;</div></div>
        <div class="arw">▸</div>
        <div class="tier" id="tStk"><div class="lab">Stock</div><div class="st"><span class="d"></span><span id="tStkSt">—</span></div><div class="sub" id="tStkSub">&nbsp;</div></div>
      </div>

      <div class="verdict">
        <div class="vtext">
          <div class="h" id="vH">—</div>
          <div class="s" id="vS">&nbsp;</div>
        </div>
        <div class="meter">
          <div class="track"><div class="pin" id="vPin" style="left:50%"></div></div>
          <div class="scale"><span>Avoid</span><span>Watch</span><span>Hold</span><span>Add</span></div>
        </div>
      </div>

      <div class="chips" id="mChips"></div>

      <div class="panel">
        <div class="ptitle"><span>Price · EMA 20 / 50 / 200 — adjusted close</span>
          <span class="legend"><span><i style="background:var(--bull)"></i>Price</span><span><i style="background:var(--fastc)"></i>20</span><span><i style="background:var(--midc)"></i>50</span><span><i style="background:var(--slowc)"></i>200</span></span></div>
        <svg id="svgPrice" viewBox="0 0 880 298" preserveAspectRatio="none" style="height:300px"></svg>
      </div>

      <div class="panel">
        <div class="ptitle"><span>Volume · bars by up / down day · 20-day average</span>
          <span class="legend"><span style="color:var(--bull)">▮ up</span><span style="color:var(--bear)">▮ down</span><span style="color:var(--gold)"><i style="background:var(--gold)"></i>avg</span></span></div>
        <svg id="svgVol" viewBox="0 0 880 78" preserveAspectRatio="none" style="height:78px"></svg>
        <div class="subnote" id="volNote"></div>
      </div>

      <div class="panel">
        <div class="ptitle"><span>OBV — on-balance volume · accumulation</span><span class="legend" id="obvLeg"></span></div>
        <svg id="svgObv" viewBox="0 0 880 92" preserveAspectRatio="none" style="height:92px"></svg>
      </div>

      <div class="foot" id="foot"></div>

    </div>
  </div>
</div>

<script>
/* ═══════════════ CONFIG ═══════════════ */
var API = 'https://script.google.com/macros/s/AKfycbxbqcip3QPPRP5YUxngoWecv5nN2eKk5h9T2WYL2_vmTs3ix6Tjt_KTfKq2MDptrmPMcw/exec';
var CHART_BARS = 180;   /* trailing window drawn (engine returns ~500) */

/* ═══════════════ HELPERS ═══════════════ */
function $(id){ return document.getElementById(id); }
function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function inr(n){ return '₹' + Number(n).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}); }
function fetchJson(url){
  return fetch(url).then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); });
}
function setTier(id, color, state, sub){
  var t = $(id); t.style.setProperty('--c', color);
  $(id+'St').textContent = state; $(id+'Sub').innerHTML = sub;
}
function tail(arr, n){ return arr.length > n ? arr.slice(arr.length - n) : arr; }

/* ═══════════════ SVG BUILDERS (real series) ═══════════════ */
function linePath(vals, X, Y){
  var d=''; for(var k=0;k<vals.length;k++){ if(vals[k]==null) continue;
    d += (d?'L':'M') + X(k).toFixed(1) + ' ' + Y(vals[k]).toFixed(1) + ' '; }
  return d.trim();
}
function findLastCross(fast, slow){
  var ps=null, last=null;
  for(var k=0;k<fast.length;k++){
    if(fast[k]==null||slow[k]==null) continue;
    var sg=Math.sign(fast[k]-slow[k]); if(sg===0) continue;
    if(ps!=null && sg!==ps) last=k; ps=sg;
  } return last;
}

function drawPrice(S, sig){
  var close=tail(S.close,CHART_BARS), e20=tail(S.ema20,CHART_BARS),
      e50=tail(S.ema50,CHART_BARS), e200=tail(S.ema200,CHART_BARS);
  var W=close.length, CW=880, CH=298, PL=6, PR=54, PT=12, PB=6;
  var all=[].concat(close,e20,e50,e200).filter(function(v){return v!=null;});
  var lo=Math.min.apply(null,all), hi=Math.max.apply(null,all), pd=(hi-lo)*0.08; lo-=pd; hi+=pd;
  var X=function(k){return PL+k/(W-1)*(CW-PL-PR);}, Y=function(v){return PT+(1-(v-lo)/(hi-lo))*(CH-PT-PB);};
  var s='';
  [0.2,0.4,0.6,0.8].forEach(function(f){ var y=(PT+f*(CH-PT-PB)).toFixed(0);
    s+='<line class="gl" x1="'+PL+'" x2="'+(CW-PR)+'" y1="'+y+'" y2="'+y+'"/>'; });
  /* cross markers computed from the REAL series inside the window */
  var gx=findLastCross(e50,e200), cx=findLastCross(e20,e50);
  if(cx!=null){ s+='<line class="xm" x1="'+X(cx).toFixed(1)+'" x2="'+X(cx).toFixed(1)+'" y1="'+PT+'" y2="'+(CH-PB)+'"/>'
    +'<text class="xmlab" x="'+X(cx).toFixed(1)+'" y="'+(PT+12)+'" text-anchor="middle">20/50 ✕</text>'; }
  if(gx!=null){ s+='<line class="xm" x1="'+X(gx).toFixed(1)+'" x2="'+X(gx).toFixed(1)+'" y1="'+PT+'" y2="'+(CH-PB)+'"/>'
    +'<text class="xmlab" x="'+X(gx).toFixed(1)+'" y="'+(CH-10)+'" text-anchor="middle" fill="var(--gold)">golden ✕</text>'; }
  s+='<path class="ln draw" style="stroke:var(--slowc)" d="'+linePath(e200,X,Y)+'"/>'
   + '<path class="ln draw" style="stroke:var(--midc)" d="'+linePath(e50,X,Y)+'"/>'
   + '<path class="ln draw" style="stroke:var(--fastc)" d="'+linePath(e20,X,Y)+'"/>'
   + '<path class="ln draw" style="stroke:var(--bull);stroke-width:1.4;opacity:.9" d="'+linePath(close,X,Y)+'"/>';
  /* right-edge dots + price label */
  var dots=[[sig.price,'var(--bull)'],[sig.ema.fast,'var(--fastc)'],[sig.ema.mid,'var(--midc)'],[sig.ema.slow,'var(--slowc)']];
  dots.forEach(function(p){ if(p[0]==null)return;
    s+='<circle cx="'+(CW-PR+7)+'" cy="'+Y(p[0]).toFixed(1)+'" r="3.4" fill="'+p[1]+'"/>'; });
  s+='<text x="'+(CW-PR+13)+'" y="'+(Y(sig.price)+3.2).toFixed(1)+'" fill="var(--bull)" font-family="var(--mono)" font-size="10.5">'+Math.round(sig.price)+'</text>';
  $('svgPrice').innerHTML=s;
}

function drawVolume(S){
  var close=tail(S.close,CHART_BARS), vol=tail(S.volume,CHART_BARS);
  var W=vol.length, CW=880, CH=78, PL=6, PR=54, vT=8, vB=CH-4;
  /* rolling 20-day MA of volume */
  var vma=[]; for(var k=0;k<W;k++){ var s0=0,n=0; for(var j=Math.max(0,k-19);j<=k;j++){s0+=vol[j];n++;} vma.push(s0/n); }
  var vMax=Math.max(Math.max.apply(null,vol), Math.max.apply(null,vma))*1.06 || 1;
  var X=function(k){return PL+k/(W-1)*(CW-PL-PR);}, Y=function(v){return vT+(1-v/vMax)*(vB-vT);};
  var bw=Math.max(1.4,(CW-PL-PR)/W*0.62), s='';
  for(var k=0;k<W;k++){
    var up=(k===0)||(close[k]>=close[k-1]);
    var y=Y(vol[k]);
    s+='<rect x="'+(X(k)-bw/2).toFixed(1)+'" y="'+y.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+(vB-y).toFixed(1)+'" fill="'+(up?'var(--upbar)':'var(--dnbar)')+'" opacity="0.9"/>';
  }
  s+='<path class="ln" style="stroke:var(--gold);stroke-width:1.4;opacity:.85" d="'+linePath(vma,X,Y)+'"/>';
  $('svgVol').innerHTML=s;
}

function drawObv(S, trend){
  var obv=tail(S.obv,CHART_BARS);
  var W=obv.length, CW=880, CH=92, PL=6, PR=54;
  var lo=Math.min.apply(null,obv), hi=Math.max.apply(null,obv), pd=(hi-lo)*0.14||1;
  var X=function(k){return PL+k/(W-1)*(CW-PL-PR);}, Y=function(v){return 6+(1-(v-(lo-pd))/((hi+pd)-(lo-pd)))*(CH-12);};
  var line=linePath(obv,X,Y);
  var area='M '+X(0).toFixed(1)+' '+(CH-4)+' ';
  for(var k=0;k<W;k++) area+='L '+X(k).toFixed(1)+' '+Y(obv[k]).toFixed(1)+' ';
  area+='L '+X(W-1).toFixed(1)+' '+(CH-4)+' Z';
  var c = trend==='rising' ? 'var(--bull)' : trend==='falling' ? 'var(--bear)' : 'var(--muted)';
  $('svgObv').innerHTML =
    '<defs><linearGradient id="og" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="'+c+'" stop-opacity=".3"/><stop offset="1" stop-color="'+c+'" stop-opacity="0"/></linearGradient></defs>'
    +'<path d="'+area+'" fill="url(#og)"/>'
    +'<path class="ln draw" style="stroke:'+c+';stroke-width:1.8" d="'+line+'"/>';
  $('obvLeg').innerHTML = trend==='rising' ? '<span style="color:var(--bull)">▲ rising — accumulation</span>'
                       : trend==='falling' ? '<span style="color:var(--bear)">▼ falling — distribution</span>'
                       : '<span>◆ flat</span>';
}

/* ═══════════════ INTERPRETATION ═══════════════ */
function verdictOf(sig, mktRegime){
  /* returns {h, s, pin%} — plain-language read + conviction pin */
  var st=sig.stack, gx=sig.cross_mid_slow, cx=sig.cross_fast_mid;
  var rv=sig.volume && sig.volume.rvol, obv=sig.volume && sig.volume.obvTrend;
  var risingSlow = sig.ema200Slope===1;
  var volBacked = rv!=null && rv>=1.5;
  var freshGolden = gx.crossed && gx.direction==='bullish' && gx.barsAgo<=5;
  var freshDeath  = gx.crossed && gx.direction==='bearish' && gx.barsAgo<=5;
  var riskOff = mktRegime==='falling';

  if(st==='bull'){
    if(freshGolden && volBacked) return {h:'Fresh golden cross on volume — strongest setup', s:'50/200 crossed within the week with RVOL '+rv.toFixed(2)+' and OBV '+obv+'. Trend igniting with participation.', pin:88};
    if(freshGolden) return {h:'Fresh golden cross — watch for volume confirmation', s:'The cross fired but participation is average. Real breakouts bring volume; give it a session or two.', pin:72};
    if(riskOff) return {h:'Bull stack, but the market is risk-off', s:'The stock is aligned but Nifty is in drawdown — the regime gate says size cautiously.', pin:58};
    if(volBacked && obv==='rising') return {h:'Trend intact and volume is picking up', s:'Aligned stack with above-average participation and rising OBV — constructive.', pin:78};
    return {h:'Trend intact — established, no fresh trigger', s:'Bull stack'+(risingSlow?' on a rising 200':'')+', but crosses are aged and volume is average. Ride it; not an ignition point.', pin:66};
  }
  if(st==='bear'){
    if(freshDeath) return {h:'Fresh death cross — trend breaking down', s:'50/200 crossed bearish within the week. Stand aside or defend positions.', pin:12};
    return {h:'Bear stack — trend is against you', s:'Price below all three EMAs. Oversold bounces happen, but the structure is down.', pin:20};
  }
  if(st==='tangled') return {h:'Tangled — no clear trend', s:'EMAs are crossing back and forth. Whipsaw zone: crossover signals are unreliable here.', pin:44};
  return {h:'Insufficient history', s:'Not enough bars to seed the 200-day EMA. Signals unavailable for this name.', pin:50};
}

/* ═══════════════ MAIN LOAD ═══════════════ */
function load(){
  var sym = $('symIn').value.trim().toUpperCase().replace(/\.NS$/,'');
  if(!sym) return;
  $('goBtn').disabled = true;
  $('status').className='status'; $('status').textContent='fetching signals + sector state for '+sym+' …';
  $('skel').style.display='block'; $('skel').textContent='loading '+sym+' …';
  $('content').style.display='none';

  var pSig = fetchJson(API+'?action=signals&sym='+encodeURIComponent(sym));
  var pSec = fetchJson(API+'?action=sector&sub=stock&sym='+encodeURIComponent(sym)).catch(function(){return null;});
  var pStock = fetchJson(API+'?action=stock&symbol='+encodeURIComponent(sym)).catch(function(){return null;});

  Promise.all([pSig,pSec,pStock]).then(function(res){
    var sig=res[0], sec=res[1], stock=res[2];
    if(!sig || !sig.ok) throw new Error(sig && sig.error ? sig.error : 'signals route returned no data');
    render(sym, sig, sec, stock);
    $('status').textContent='loaded '+new Date().toLocaleTimeString('en-IN',{hour12:false})+' IST · signals live · '
      + (sec && sec.ok ? 'sector live' : 'sector unavailable') + ' · '
      + (stock && stock.summary ? 'name live' : 'name unavailable');
  }).catch(function(e){
    $('status').className='status err';
    $('status').textContent='✗ '+e.message+' — check the symbol, or the deployment if this persists';
    $('skel').textContent='could not load '+sym;
  }).finally ? Promise.resolve().then(function(){ $('goBtn').disabled=false; })
             : ($('goBtn').disabled=false);
  /* finally polyfill-safe re-enable */
  setTimeout(function(){ $('goBtn').disabled=false; }, 15000);
}

function render(sym, sig, sec, stock){
  /* header */
  $('hTick').innerHTML='<b>'+esc(sym)+'</b>';
  var longName = stock && stock.summary && stock.summary.longName ? stock.summary.longName : '';
  var secLabel = sec && sec.ok && sec.sectorLabel ? sec.sectorLabel : '';
  $('hName').textContent = [longName, secLabel].filter(Boolean).join(' · ') || '—';
  $('hPx').textContent = inr(sig.price);
  $('hChips').innerHTML =
    '<span class="chip live">● LIVE</span>'
    +'<span class="chip'+(sig.adjusted?'':' warn')+'">'+(sig.adjusted?'ADJUSTED':'⚠ RAW CLOSE')+' · '+sig.bars+' BARS</span>';

  /* ── funnel: MARKET tier (from sector route's regime) ── */
  if(sec && sec.regime){
    var rg=sec.regime;
    var mc = rg==='normal' ? '#c9b24a' : rg==='recovery' ? 'var(--bull)' : rg==='falling' ? 'var(--bear)' : 'var(--slate)';
    var msub = rg==='normal' ? 'Above the drawdown gate · risk-on'
             : rg==='recovery' ? 'Post-drawdown turn confirmed · leadership odds active'
             : rg==='falling' ? 'In drawdown, no turn yet · risk-off — size cautiously'
             : 'Regime unavailable';
    setTier('tMkt', mc, rg.toUpperCase(), msub);
  } else {
    setTier('tMkt','var(--slate)','UNAVAILABLE','Sector route returned nothing — regime unknown (run sectorRefresh once?)');
  }

  /* ── funnel: SECTOR tier ── */
  if(sec && sec.ok && sec.rotation){
    var r=sec.rotation;
    var rs6=r.rs6!=null?(r.rs6>=0?'+':'')+(r.rs6*100).toFixed(1)+'%':'—';
    var sc = r.rs6!=null && r.rs6>0 ? 'var(--bull)' : r.rs6!=null ? 'var(--bear)' : 'var(--slate)';
    var lead = sec.leadership ? ' · <b style="color:var(--gold)">top-3 leadership odds</b>' : '';
    setTier('tSec', sc, (sec.sectorLabel||'SECTOR').toUpperCase()+' #'+r.rank,
      'RS vs Nifty: '+rs6+' (6M) · rank '+r.rank+'/'+sec.totalSectors+lead
      +(r.valLabel?' · P/E '+esc(r.valLabel):''));
  } else if(sec && sec.ok===false && /no sector mapping/.test(sec.error||'')){
    setTier('tSec','var(--slate)', (secLabel||'NO INDEX'),
      'No NSE sectoral index mapped for this stock — tier degrades gracefully rather than faking a read');
  } else {
    setTier('tSec','var(--slate)','UNAVAILABLE','Sector state not loaded — rotation standing unknown');
  }

  /* ── funnel: STOCK tier ── */
  var stC = sig.stack==='bull'?'var(--bull)':sig.stack==='bear'?'var(--bear)':sig.stack==='tangled'?'var(--gold)':'var(--slate)';
  var stTxt = sig.stack==='bull'?'BULL STACK':sig.stack==='bear'?'BEAR STACK':sig.stack==='tangled'?'TANGLED':'UNAVAILABLE';
  var stSub = sig.stack==='bull' ? 'price ▸ EMA20 ▸ EMA50 ▸ EMA200 aligned'+(sig.ema200Slope===1?' · 200 rising':sig.ema200Slope===-1?' · 200 falling':'')
            : sig.stack==='bear' ? 'price ▾ EMA20 ▾ EMA50 ▾ EMA200 — structure is down'
            : sig.stack==='tangled' ? 'EMAs interleaved — whipsaw zone, low signal reliability'
            : 'Under 200 bars of history — long EMAs cannot seed';
  setTier('tStk', stC, stTxt, stSub);

  /* ── verdict ── */
  var v = verdictOf(sig, sec && sec.regime);
  $('vH').textContent=v.h; $('vS').textContent=v.s; $('vPin').style.left=v.pin+'%';

  /* ── chips ── */
  var ch='';
  function chip(html){ ch+='<span class="mchip">'+html+'</span>'; }
  if(sig.ema.fast!=null) chip('EMA20 <b>'+sig.ema.fast.toFixed(1)+'</b>');
  if(sig.ema.mid!=null)  chip('EMA50 <b>'+sig.ema.mid.toFixed(1)+'</b>');
  if(sig.ema.slow!=null) chip('EMA200 <b>'+sig.ema.slow.toFixed(1)+'</b> '+(sig.ema200Slope===1?'<span class="up">↑</span>':sig.ema200Slope===-1?'<span class="dn">↓</span>':''));
  var gx=sig.cross_mid_slow, cx=sig.cross_fast_mid;
  chip((gx.crossed? (gx.direction==='bullish'?'Golden':'<span class="dn">Death</span>')+' cross <b>'+gx.barsAgo+'d</b>'+(gx.fresh?' <span class="gd">● fresh</span>':'') : '50/200 <b>no cross</b>'));
  chip((cx.crossed? '20/50 '+(cx.direction==='bullish'?'<span class="up">bull</span>':'<span class="dn">bear</span>')+' <b>'+cx.barsAgo+'d</b>'+(cx.fresh?' <span class="gd">● fresh</span>':'') : '20/50 <b>no cross</b>'));
  if(sig.volume && sig.volume.rvol!=null){
    var rv=sig.volume.rvol;
    chip('RVOL <b>'+rv.toFixed(2)+'</b>'+(rv>=2?' <span class="gd">▲▲</span>':rv>=1.5?' <span class="up">▲</span>':''));
    chip('OBV '+(sig.volume.obvTrend==='rising'?'<span class="up">▲ rising</span>':sig.volume.obvTrend==='falling'?'<span class="dn">▼ falling</span>':'◆ flat'));
  } else {
    chip('Volume <b>unavailable</b>');
  }
  $('mChips').innerHTML=ch;

  /* ── charts from the REAL series ── */
  var S=sig.series||{};
  if(S.close && S.ema20){ drawPrice(S,sig); } else { $('svgPrice').innerHTML='<text x="440" y="150" text-anchor="middle" fill="var(--faint)" font-family="var(--mono)" font-size="12">series unavailable — redeploy the engine with close+volume in series</text>'; }
  if(S.close && S.volume){ drawVolume(S);
    var rvN = sig.volume&&sig.volume.rvol!=null?sig.volume.rvol.toFixed(2):'—';
    $('volNote').textContent = 'RVOL '+rvN+(sig.volume&&sig.volume.rvol>=1.5?' — above-average participation':' — average participation, no volume surge');
  } else { $('svgVol').innerHTML=''; $('volNote').textContent='volume series unavailable'; }
  if(S.obv){ drawObv(S, sig.volume?sig.volume.obvTrend:null); } else { $('svgObv').innerHTML=''; }

  /* ── foot ── */
  $('foot').innerHTML='<b>All values live</b> — '+sig.bars+' split-adjusted bars via the signals route; market/sector tiers via the sector route; crosses marked where the real EMA series intersect within the drawn window ('+CHART_BARS+' bars).';

  $('skel').style.display='none';
  $('content').style.display='block';
}

/* enter-to-load + auto-load HAL on first open */
$('symIn').addEventListener('keydown', function(e){ if(e.key==='Enter') load(); });
window.addEventListener('load', load);
</script>
</body>
</html>
